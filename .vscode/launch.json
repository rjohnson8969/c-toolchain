{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "program": "c:/Users/riley/Documents/c-toolchain/main.exe",
      "args": [
        "2",
        "3"
